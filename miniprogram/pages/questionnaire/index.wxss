page {
  min-height: 100%;
  background: #ffffff;
}

.question-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  max-height: 100vh;
  overflow: hidden;
  padding: 0 28rpx;
  background: #ffffff;
}

.progress-header {
  z-index: 5;
  flex: none;
  padding: 18rpx 4rpx 14rpx;
  background: #ffffff;
}

.progress-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 56rpx;
  margin-bottom: 12rpx;
  color: #66726e;
  font-size: 24rpx;
}

.progress-position,
.progress-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.review-badge {
  padding: 6rpx 12rpx;
  border-radius: 6rpx;
  color: #176b5c;
  background: #e5f1ed;
  font-size: 21rpx;
  font-weight: 650;
}

.missing-trigger {
  min-width: 124rpx;
  height: 54rpx;
  padding: 0 16rpx;
  border: 2rpx solid #b9d4cc;
  border-radius: 8rpx;
  color: #176b5c;
  background: #edf5f2;
  font-size: 23rpx;
  font-weight: 650;
  line-height: 50rpx;
}

.missing-trigger.complete {
  border-color: #dce3e0;
  color: #77827e;
  background: #f4f6f5;
}

.progress-track {
  height: 12rpx;
  overflow: hidden;
  border-radius: 6rpx;
  background: #e6ebe9;
}

.progress-fill {
  height: 100%;
  background: #187a68;
  transition: width 0.2s;
}

.question-body {
  display: flex;
  flex-direction: column;
  flex: 1;
  min-height: 0;
  width: 100%;
  overflow: hidden;
  padding: 22rpx 4rpx 18rpx;
}

.question-prompt {
  display: flex;
  flex: 0 1 160rpx;
  flex-direction: column;
  min-height: 84rpx;
  overflow: hidden;
}

.question-number {
  color: #187a68;
  font-size: 24rpx;
  font-weight: 650;
}

.question-text-scroll {
  flex: 1;
  min-height: 0;
  margin-top: 12rpx;
  overflow: hidden;
}

.question-text {
  padding-bottom: 12rpx;
  font-size: 39rpx;
  font-weight: 700;
  line-height: 1.55;
  word-break: break-word;
}

.choice-list {
  display: flex;
  flex: 1;
  align-self: stretch;
  flex-direction: column;
  min-height: 0;
  max-width: 100%;
  gap: 12rpx;
  margin-top: 12rpx;
}

.choice-button {
  display: grid;
  flex: none;
  grid-template-columns: 60rpx minmax(0, 1fr) 38rpx;
  column-gap: 24rpx;
  align-items: center;
  align-self: stretch;
  min-width: 0;
  max-width: 100%;
  width: 100%;
  height: auto;
  padding: 20rpx 26rpx;
  border: 2rpx solid #d8e0dd;
  border-radius: 12rpx;
  color: #34413c;
  background: #f8faf9;
  font-size: 32rpx;
  font-weight: 550;
  line-height: 1.4;
  text-align: left;
  overflow: hidden;
}

.choice-button.selected {
  border-color: #187a68;
  color: #115e51;
  background: #e4f1ed;
  box-shadow: inset 0 0 0 2rpx rgba(24, 122, 104, 0.08);
}

.choice-index {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  width: 60rpx;
  height: 60rpx;
  border: 2rpx solid #c5d0cc;
  border-radius: 50%;
  color: #68736f;
  font-size: 27rpx;
}

.selected .choice-index {
  border-color: #187a68;
  color: #ffffff;
  background: #187a68;
}

.choice-label {
  display: block;
  min-width: 0;
  width: 100%;
  line-height: 1.4;
  text-align: left;
  white-space: normal;
  overflow-wrap: break-word;
  word-break: break-word;
}

.choice-check {
  width: 38rpx;
  color: #187a68;
  font-size: 30rpx;
  text-align: right;
}

.scroll-mode {
  height: auto;
  max-height: none;
  min-height: 100vh;
  overflow: visible;
}

.scroll-mode .question-body {
  flex: none;
  min-height: 0;
  overflow: visible;
}

.scroll-mode .question-prompt {
  flex: none;
  height: 160rpx;
}

.scroll-mode .choice-list {
  flex: none;
}

.scroll-mode .question-actions-panel {
  position: -webkit-sticky;
  position: sticky;
  bottom: 0;
}

.question-actions-panel {
  z-index: 4;
  flex: none;
  margin: 0 -28rpx;
  padding: 12rpx 28rpx calc(10rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #edf0ef;
  background: #ffffff;
}

.question-footer {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 80rpx minmax(0, 1fr);
  gap: 12rpx;
}

.nav-button,
.submit-button {
  min-height: 88rpx;
  height: auto;
  padding: 18rpx 16rpx;
  line-height: 1.45;
}

.nav-button {
  color: #52605b;
  background: #eef1f0;
}

.nav-button[disabled] {
  color: #aab1ae;
  background: #f5f6f6;
}

.missing-action {
  color: #176b5c;
  background: #e5f1ed;
}

.submit-button {
  color: #ffffff;
  background: #187a68;
}

.reset-button {
  width: 100%;
  min-height: 88rpx;
  padding: 0;
  border: 2rpx solid #d5dedb;
  color: #43514c;
  background: #f2f5f4;
  font-size: 25rpx;
  font-weight: 650;
  line-height: 88rpx;
}

.drawer-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(18, 27, 24, 0.48);
}

.missing-drawer {
  width: 100%;
  max-height: 65vh;
  padding: 14rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  border-radius: 16rpx 16rpx 0 0;
  background: #ffffff;
}

.drawer-handle {
  width: 72rpx;
  height: 8rpx;
  margin: 0 auto 18rpx;
  border-radius: 4rpx;
  background: #d5dcda;
}

.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid #e3e8e6;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 750;
}

.drawer-subtitle {
  margin-top: 6rpx;
  color: #77827e;
  font-size: 23rpx;
}

.drawer-close {
  width: 68rpx;
  height: 68rpx;
  padding: 0;
  color: #68736f;
  background: #f1f4f3;
  font-size: 38rpx;
  font-weight: 350;
  line-height: 64rpx;
}

.missing-scroll { width: 100%; }

.missing-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 14rpx;
  padding: 24rpx 0 10rpx;
}

.missing-number {
  width: 100%;
  height: 76rpx;
  padding: 0;
  border: 2rpx solid #d7dfdc;
  border-radius: 8rpx;
  color: #3f4c47;
  background: #f7f9f8;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 72rpx;
}

.missing-number.current {
  border-color: #187a68;
  color: #ffffff;
  background: #187a68;
}

@media screen and (max-height: 700px) {
  .progress-header { padding-top: 10rpx; padding-bottom: 10rpx; }
  .progress-row { min-height: 52rpx; margin-bottom: 8rpx; }
  .question-body { padding-top: 14rpx; padding-bottom: 12rpx; }
  .question-prompt { flex-basis: 124rpx; }
  .question-text-scroll { margin-top: 8rpx; }
  .choice-list { gap: 8rpx; margin-top: 8rpx; }
  .question-actions-panel { padding-top: 8rpx; padding-bottom: calc(8rpx + env(safe-area-inset-bottom)); }
}

@media screen and (min-height: 800px) {
  .choice-button { min-height: 112rpx; }
  .choice-list { gap: 18rpx; }
}
