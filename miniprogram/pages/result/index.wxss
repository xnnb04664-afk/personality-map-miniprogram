.result-page { padding-bottom: 70rpx; background: #f4f6f5; }
.report-head { padding: 42rpx 32rpx 34rpx; background: #e7f1ed; border-bottom: 1rpx solid #d3e2dd; }
.report-eyebrow { color: #176b5c; font-size: 23rpx; font-weight: 650; }
.report-title { max-width: 680rpx; margin-top: 18rpx; font-size: 40rpx; font-weight: 760; line-height: 1.42; }
.profile-caption { margin-top: 8rpx; color: #62716c; font-size: 21rpx; }
.report-date { margin-top: 20rpx; color: #68736f; font-size: 23rpx; }
.report-note { margin-top: 24rpx; padding-top: 20rpx; border-top: 1rpx solid #cadbd5; color: #53605b; font-size: 23rpx; line-height: 1.6; }
.report-tabs { position: -webkit-sticky; position: sticky; top: 0; z-index: 20; display: grid; grid-template-columns: repeat(3, 1fr); gap: 8rpx; padding: 14rpx 24rpx; border-bottom: 1rpx solid #dfe5e2; background: rgba(255, 255, 255, 0.98); }
.report-tab { display: flex; align-items: center; justify-content: center; height: 68rpx; padding: 0; color: #68736f; background: #f2f4f3; font-size: 25rpx; line-height: 1.4; }
.report-tab.active { color: #ffffff; background: #187a68; }
.report-section { padding: 34rpx 32rpx; border-bottom: 12rpx solid #f4f6f5; background: #ffffff; }
.section-heading { margin-bottom: 24rpx; font-size: 31rpx; font-weight: 750; }
.radar-canvas { display: block; width: 100%; height: 590rpx; margin: 0 auto 24rpx; }
.domain-overview { margin-bottom: 22rpx; }
.domain-overview:last-child { margin-bottom: 0; }
.domain-overview-meta { display: flex; justify-content: space-between; margin-bottom: 9rpx; font-size: 25rpx; font-weight: 650; }
.domain-track, .facet-track { height: 12rpx; overflow: hidden; border-radius: 6rpx; background: #e7ebe9; }
.domain-fill, .facet-track view { min-width: 8rpx; height: 100%; }
.prominent-row { display: flex; gap: 20rpx; padding: 20rpx 0; border-bottom: 1rpx solid #e5e9e7; color: #56625e; font-size: 24rpx; line-height: 1.6; }
.prominent-row:last-child { border-bottom: 0; }
.prominent-rank { display: flex; align-items: center; justify-content: center; flex: none; width: 48rpx; height: 48rpx; border-radius: 50%; color: #ffffff; background: #187a68; font-size: 22rpx; font-weight: 700; }
.prominent-copy { min-width: 0; flex: 1; }
.prominent-name { margin-bottom: 5rpx; color: #25312d; font-size: 27rpx; font-weight: 700; }
.ai-section { border-top: 1rpx solid #dfe8e5; }
.ai-intro, .ai-overview { color: #43504b; font-size: 26rpx; line-height: 1.75; }
.ai-title { margin-bottom: 16rpx; color: #183c34; font-size: 33rpx; font-weight: 750; line-height: 1.5; }
.ai-generate { display: flex; align-items: center; justify-content: center; height: 88rpx; margin-top: 26rpx; padding: 0; color: #ffffff; background: #187a68; line-height: 1.4; text-align: center; }
.ai-generate[disabled] { color: #7b8581; background: #e7ebe9; }
.ai-privacy, .ai-disclaimer { margin-top: 16rpx; color: #7b8581; font-size: 21rpx; line-height: 1.6; }
.ai-error { margin-top: 18rpx; padding: 18rpx; border-left: 6rpx solid #b54848; color: #7c4141; background: #faeeee; font-size: 23rpx; line-height: 1.6; }
.ai-subheading { margin: 30rpx 0 14rpx; color: #25312d; font-size: 27rpx; font-weight: 720; }
.ai-evidence { padding: 18rpx 0; border-bottom: 1rpx solid #e6eae8; color: #596560; font-size: 24rpx; line-height: 1.65; }
.ai-evidence-name { margin-bottom: 5rpx; color: #176b5c; font-weight: 700; }
.ai-columns { display: grid; grid-template-columns: 1fr 1fr; gap: 28rpx; }
.ai-column { min-width: 0; }
.ai-list-item { margin-bottom: 12rpx; color: #56625e; font-size: 23rpx; line-height: 1.65; }
.context-row { padding: 17rpx 0; border-bottom: 1rpx solid #e6eae8; color: #58645f; font-size: 24rpx; line-height: 1.65; }
.context-row text { display: block; margin-bottom: 5rpx; color: #25312d; font-weight: 700; }
.action-list { padding: 4rpx 0; }
.action-item { display: flex; gap: 16rpx; margin-bottom: 16rpx; color: #43504b; font-size: 24rpx; line-height: 1.65; }
.action-item text { display: flex; align-items: center; justify-content: center; flex: none; width: 42rpx; height: 42rpx; border-radius: 50%; color: #ffffff; background: #187a68; font-size: 20rpx; }
.view-intro { color: #65716d; font-size: 24rpx; line-height: 1.7; }
.domain-detail { padding: 28rpx 32rpx; border-bottom: 12rpx solid #f4f6f5; background: #ffffff; }
.domain-toggle { display: flex; align-items: center; justify-content: space-between; }
.domain-name { font-size: 31rpx; font-weight: 750; }
.domain-english { margin-top: 4rpx; color: #89928f; font-size: 21rpx; }
.domain-toggle-score { display: flex; align-items: center; gap: 18rpx; font-size: 43rpx; font-weight: 760; }
.domain-toggle-score text { width: 42rpx; color: #68736f; font-size: 34rpx; font-weight: 400; text-align: center; }
.detail-track { margin-top: 18rpx; }
.domain-expanded { margin-top: 26rpx; padding-top: 24rpx; border-top: 1rpx solid #e2e7e5; }
.domain-summary { color: #3f4b47; font-size: 27rpx; line-height: 1.75; }
.insight-row { padding: 18rpx 0; border-bottom: 1rpx solid #e7ebe9; color: #56625e; font-size: 24rpx; line-height: 1.65; }
.insight-row text { display: block; margin-bottom: 6rpx; color: #25312d; font-weight: 700; }
.insight-row.action { border-bottom: 0; }
.short-facet-notice { padding: 26rpx 32rpx; border-left: 8rpx solid #d9823f; color: #675547; background: #fbf3eb; font-size: 23rpx; line-height: 1.7; }
.short-notice-title { margin-bottom: 5rpx; color: #59483b; font-weight: 700; }
.facet-group { padding: 30rpx 32rpx; border-bottom: 12rpx solid #f4f6f5; background: #ffffff; }
.facet-group-title { display: flex; justify-content: space-between; padding-bottom: 20rpx; border-bottom: 2rpx solid #dfe5e2; font-size: 31rpx; font-weight: 750; }
.facet-row { min-height: 118rpx; padding: 20rpx 0; border-bottom: 1rpx solid #e8ebe9; }
.facet-row:last-child { border-bottom: 0; }
.facet-copy { min-width: 0; }
.facet-line { display: flex; justify-content: space-between; gap: 18rpx; font-size: 26rpx; font-weight: 680; }
.facet-line text:last-child { flex: none; color: #56625e; font-size: 23rpx; }
.facet-description { margin-top: 7rpx; color: #77817d; font-size: 22rpx; line-height: 1.45; }
.facet-track { height: 8rpx; margin-top: 13rpx; }
.report-actions { display: flex; flex-direction: column; gap: 18rpx; padding: 38rpx 32rpx 20rpx; background: #ffffff; }
.disclaimer { padding: 10rpx 46rpx; color: #818a87; background: #ffffff; font-size: 21rpx; line-height: 1.65; text-align: center; }
.poster-canvas { position: absolute; top: 0; left: 0; z-index: -1; width: 300px; height: 410px; opacity: 0; pointer-events: none; }
.ai-consent-mask { position: fixed; top: 0; right: 0; bottom: 0; left: 0; z-index: 100; display: flex; align-items: center; justify-content: center; padding: 40rpx; background: rgba(18, 27, 24, 0.52); }
.ai-consent-dialog { width: 100%; max-width: 640rpx; padding: 38rpx 32rpx 30rpx; border-radius: 14rpx; background: #ffffff; box-shadow: 0 12rpx 50rpx rgba(18, 27, 24, 0.18); }
.ai-consent-title { color: #17201d; font-size: 34rpx; font-weight: 750; line-height: 1.45; }
.ai-consent-copy { margin-top: 22rpx; color: #43504b; font-size: 26rpx; line-height: 1.75; }
.ai-consent-note { margin-top: 18rpx; padding: 16rpx 18rpx; color: #68736f; background: #f4f7f6; font-size: 23rpx; line-height: 1.6; }
.ai-consent-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 18rpx; margin-top: 28rpx; }
.ai-consent-actions button { display: flex; align-items: center; justify-content: center; height: 82rpx; padding: 0; line-height: 1.4; font-size: 26rpx; text-align: center; }
.ai-consent-cancel { color: #56615d; background: #eef1f0; }
.ai-consent-confirm { color: #ffffff; background: #187a68; }

@media screen and (max-width: 360px) {
  .report-head, .report-section, .domain-detail, .facet-group { padding-right: 26rpx; padding-left: 26rpx; }
  .radar-canvas { height: 560rpx; }
  .ai-columns { grid-template-columns: 1fr; gap: 0; }
}
