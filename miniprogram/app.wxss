page {
  min-height: 100%;
  background: #f4f6f5;
  color: #17201d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  font-size: 28rpx;
  letter-spacing: 0;
}

view, text, button, canvas {
  box-sizing: border-box;
}

button {
  margin: 0;
  border-radius: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0;
}

button::after {
  border: 0;
}

.page-shell {
  width: 100%;
  max-width: 820rpx;
  margin: 0 auto;
  padding: 32rpx 32rpx 64rpx;
}

.primary-button {
  height: 92rpx;
  line-height: 92rpx;
  color: #ffffff;
  background: #187a68;
}

.secondary-button {
  height: 84rpx;
  line-height: 84rpx;
  color: #187a68;
  background: #e5f1ed;
}

.ghost-button {
  height: 76rpx;
  line-height: 76rpx;
  color: #56615d;
  background: transparent;
}

.section-title {
  margin: 42rpx 0 22rpx;
  font-size: 30rpx;
  font-weight: 700;
}

.muted {
  color: #6c7773;
}

.empty-state {
  padding: 120rpx 30rpx;
  text-align: center;
  color: #6c7773;
}
